# Pitch Perfect — Speed-to-Lead Demo — environment template
# Copy this file to .env.local and fill in the real value. .env.local is gitignored.

# Anthropic API key — server-side only. The browser never sees this.
# The /api/chat route is the only thing that talks to Anthropic.
ANTHROPIC_API_KEY=

# Conversation model. Sonnet 4.6 is the locked default; Haiku 4.5 is the latency fallback.
#   claude-sonnet-4-6            (default)
#   claude-haiku-4-5-20251001   (fallback)
ANTHROPIC_MODEL=claude-sonnet-4-6
